# Copy to .env and edit. Everything in this file is handed to the container as-is
# (docker-compose.yml reads it with env_file), and anything left out simply keeps
# the default from DockerUI/settings.py.

# --- Registry ---------------------------------------------------------------
REGISTRY_URL=http://127.0.0.1:5000
# classic | artifactory
REGISTRY_TYPE=classic
# Namespace prefix; for Artifactory, the Docker repository key.
REGISTRY_REPO=
REGISTRY_SSL_VERIFY=False

# Credentials for the registry, if it asks for any.
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# --- Application ------------------------------------------------------------
DEBUG=False
# Signs the session cookie that carries the admin flag: generate a real one.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
# Host port. The container always listens on 8000.
PORT=8000

# Comma-separated list of origins (scheme+host) trusted for CSRF-protected POSTs.
# Required as soon as the UI is accessed via HTTPS or a non-localhost hostname,
# otherwise the admin login answers 403.
#   CSRF_TRUSTED_ORIGINS=https://dockerui.example.com
CSRF_TRUSTED_ORIGINS=

# --- Admin mode -------------------------------------------------------------
# Leave empty to disable admin mode (stats page, tag deletion) entirely.
ADMIN_PASSWORD=

# --- Optional: hardening ----------------------------------------------------
# Hostnames Django will answer for. Defaults to * -- set it when the UI is not
# behind a proxy that already validates the Host header.
#ALLOWED_HOSTS=dockerui.example.com
# Believe X-Forwarded-Proto / X-Forwarded-For. Only behind a proxy that always
# overwrites them, otherwise clients can forge both.
#TRUST_PROXY=False
# Restrict the session and CSRF cookies to HTTPS. Breaks the login over plain HTTP.
#SECURE_COOKIES=False
# How long an admin session stays valid, in seconds (default 8 hours).
#SESSION_COOKIE_AGE=28800
# Failed logins per client address before the form locks, and for how long.
#ADMIN_LOGIN_MAX_ATTEMPTS=10
#ADMIN_LOGIN_LOCKOUT_SECONDS=300

# --- Optional: performance --------------------------------------------------
# Seconds a registry response stays cached.
#REGISTRY_CACHE_TTL=300
# Parallel requests to the registry per page load. Lower it if the registry
# complains, raise it if it does not and the catalog is large.
#REGISTRY_MAX_WORKERS=8
# Where the response cache is written, inside the container, and how many entries
# it keeps.
#CACHE_LOCATION=/tmp/dockerui-cache
#CACHE_MAX_ENTRIES=20000
# DEBUG | INFO | WARNING | ERROR
#LOG_LEVEL=INFO
